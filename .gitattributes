# Store everything as LF in the repo, converting back to CRLF on checkout under Windows.
# Without this file, collaborators on different operating systems generate whole-file phantom diffs.
* text=auto eol=lf

# Binary data: no line-ending conversion at all, or the files are corrupted
*.bin  binary
*.png  binary
*.jpg  binary
*.mp4  binary
*.wav  binary
*.ttc  binary
*.woff binary
*.woff2 binary
